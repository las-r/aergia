# standard array library
# by las-r
# with some functions based off lyxal

{arr_has :arr itm:
    [`arr aitm
        (== aitm itm
            ? 1
        )
    ]
    ? 0
}

{arr_reverse :arr:
    = out <>
    [`arr itm
        *: out 0 itm
    ]
    ? out
}

{arr_index :arr tar:
    = idx 0
    [`arr itm
        (== itm tar
            ? idx
        )
        =+ idx 1
    ]
    ? _1
}

# based off lyxal
{arr_map :arr f:
    = out <>
    [`arr arg
        +: out @f:arg:
    ] 
    ? out
}

# based off lyxal
{arr_filter :arr f:
    = out <>
    [`arr arg
        (@f:arg:
            +: out arg
        )
    ]
    ? out
}

# based off lyxal
{arr_reduce :arr ini fn:
    = acc ini
    = fn +"{ f :x y:" +fn "} @f:acc curr:"
    [`arr curr
        = acc ; fn
    ]
    ? acc
}

# based off lyxal
{arr_iota :n:
    = out <>
    = i 0
    [<< i n
        +: out i
        =+ i 1
    ]
    ? out
}