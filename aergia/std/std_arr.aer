# standard array library
# by las-r
# with some functions based off lyxal

{has :arr itm:
    [`arr aitm
        (== aitm itm
            ? 1
        )
    ]
    ? 0
}

{reverse :arr:
    = out <>
    [`arr itm
        *: out 0 itm
    ]
    ? out
}

{index :arr tar:
    = idx 0
    [`arr itm
        (== itm tar
            ? idx
        )
        =+ idx 1
    ]
    ? _1
}

# based off lyxal
{map :arr f:
    = out <>
    [`arr arg
        +: out @f:arg:
    ] 
    ? out
}

# based off lyxal
{filter :arr f:
    = out <>
    [`arr arg
        (@f:arg:
            +: out arg
        )
    ]
    ? out
}

# based off lyxal
{reduce :arr ini f:
    = out ini
    [`arr cur
        = out @f:out cur:
    ]
    ? out
}

# based off lyxal
{iota :n:
    = out <>
    = i 0
    [<< i n
        +: out i
        =+ i 1
    ]
    ? out
}