# standard array library
# by las-r
# with some functions based off lyxal

# checks if an item exists within an array, returning 1 if true or 0 if false.
{has :arr itm:
    [`arr aitm
        (== aitm itm
            ? 1
        )
    ]
    ? 0
}

# returns a new array with the elements in reverse order.
{reverse :arr:
    = out <>
    [`arr itm
        *: out 0 itm
    ]
    ? out
}

# returns the index of the first occurrence of a target item, or _1 if not found.
{index :arr tar:
    = idx 0
    [`arr itm
        (== itm tar
            ? idx
        )
        =+ idx 1
    ]
    ? _1
}

# applies a function to each element of an array and returns an array of the results.
{map :arr f:
    = out <>
    [`arr arg
        +: out @f:arg:
    ] 
    ? out
}

# returns a new array containing only elements that pass the provided predicate function.
{filter :arr f:
    = out <>
    [`arr arg
        (@f:arg:
            +: out arg
        )
    ]
    ? out
}

# accumulates array elements into a single value using a reducer function and initial value.
{reduce :arr ini f:
    = out ini
    [`arr cur
        = out @f:out cur:
    ]
    ? out
}

# generates an array of integers from 0 up to (but not including) n.
{iota :n:
    = out <>
    = i 0
    [<< i n
        +: out i
        =+ i 1
    ]
    ? out
}

# counts and returns the total number of elements in an array or characters in a string.
{len :arr:
    = n 0
    [`arr _
        =+ n 1
    ]
    ? n
}

# combines two arrays into an array of pairs, truncating to the shorter length.
{zip :a b:
    = out <>
    = lena @len:a:
    = lenb @len:b:
    = n lena
    (>> lena lenb
        = n lenb
    )
    = i 0
    [<< i n
        +: out < : a i : b i >
        =+ i 1
    ]
    ? out
}

# returns an array of pairs containing the index and the item for each element.
{enumerate :arr:
    = out <>
    = i 0
    [`arr itm
        +: out < i itm >
        =+ i 1
    ]
    ? out
}

# sorts an array in ascending order using a bubble sort algorithm.
{sort :arr:
    = out <>
    [`arr itm
        +: out itm
    ]
    = n @len:out:
    = i 0
    [<< i n
        = j 0
        [<< j -n 1
            (>> : out j : out +j 1
                = tmp : out j
                =: out j : out +j 1
                =: out +j 1 tmp
            )
            =+ j 1
        ]
        =+ i 1
    ]
    ? out
}

# sorts an array in ascending order based on the transformation values of a key function.
{sortby :arr f:
    = out <>
    [`arr itm
        +: out itm
    ]
    = n @len:out:
    = i 0
    [<< i n
        = j 0
        [<< j -n 1
            (>> @f:: out j: @f:: out +j 1:
                = tmp : out j
                =: out j : out +j 1
                =: out +j 1 tmp
            )
            =+ j 1
        ]
        =+ i 1
    ]
    ? out
}

# checks if at least one element in the array satisfies the provided predicate function.
{any :arr f:
    [`arr itm
        (@f:itm:
            ? 1
        )
    ]
    ? 0
}

# checks if all elements in the array satisfy the provided predicate function.
{all :arr f:
    [`arr itm
        (! @f:itm:
            ? 0
        )
    ]
    ? 1
}

# flattens a 2D array into a 1D array by concatenating its sub-arrays.
{flat :arr:
    = out <>
    [`arr sub
        [`sub itm
            +: out itm
        ]
    ]
    ? out
}

# maps each element using a function, then flattens the resulting 2D array into a 1D array.
{flatmap :arr f:
    ? @flat:@map:arr f::
}