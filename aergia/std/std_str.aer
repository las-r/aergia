# standard string library
# by las-r

# joins an array of items into a single string separated by a delimiter string.
{join :arr del:
    = out ""
    = first 1
    [`arr itm
        (== first 1
            = out itm
            = first 0
        ) -> (
            =+ out +del itm
        )
    ]
    ? out
}

# splits a string into an array of substrings based on a delimiter character.
{split :str del:
    = out < >
    = cur ""
    [`str chr
        (!= del ""
            (== chr del
                +: out cur
                = cur ""
            ) -> (
               =+ cur chr
            )
        ) -> (
            +: out chr
        )
    ]
    (!= del ""
        +: out cur
    )
    ? out
}

# verifies if a string contains a specific substring sequence.
{has :str seq:
    = matchidx 0
    = found 0
    [`str chr
        = target ""
        = idxcheck 0
        [`seq schr
            (== idxcheck matchidx
                = target schr
            )
            =+ idxcheck 1
        ]
        (== chr target
            =+ matchidx 1
        ) -> (
            = matchidx 0
        )
        (== target ""
            = found 1
        )
    ]
    ? found
}

# reverses the characters of a string.
{reverse :str:
    = out <>
    [`str chr
        *: out 0 chr
    ]
    ? @join:out "":
}

# trims leading white space from the left side of a string.
{ltrim :str:
    = out ""
    = start 0
    [`str chr
        (|| start != chr " "
            = start 1
            =+ out chr
        )
    ]
    ? out
}

# trims trailing white space from the right side of a string.
{rtrim :str: 
    ? @reverse:@ltrim:@reverse:str:::
}

# strips both leading and trailing white space from a string.
{trim :str:
    ? @ltrim:@rtrim:str::
}