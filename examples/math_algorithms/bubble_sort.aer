+< "std_arr.aer" arr

{bubble_sort :a:
    = n @arr.len:a:
    [1
        = nn 0
        [`@arr.iota:-n 1: i
            =+ i 1
            (>> : a -i 1 : a i
                @arr.swap:a -i 1 i:
                = nn i
            )
        ]
        = n nn
        (<= n 1
            <<<
        )
    ]
}

= a < 9 8 7 5 4 6 >
> a
@bubble_sort:a:
> a