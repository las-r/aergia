*< random r

= secret @r.randint:1 100:
= guess 0
= tries 0

> "--- Guess the Number (1-100) ---"

[!= guess secret
    > "Enter your guess:"
    = guess .
    =+ tries 1

    (<< guess secret
    > "Too low!"
    ) -> (
        (>> guess secret
            > "Too high!"
        ) -> (
            > "Correct, you got it in %tries% tries!"
        )
    )
]