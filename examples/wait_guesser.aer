*< builtins py
*< random r
*< time t

# settings
= accu 3
= maxwait 5

# wait
= wait @py.round:*@r.random maxwait accu:
> "Starting the wait in 1 second..."
@t.sleep:1:
> ""
> "Start!"
@t.sleep:wait:
> "Finish!"

# user guess
> ""
> "Enter the amount of seconds you waited: "
= guess '

# results
> ""
> +"You waited for %wait% second(s)."
> "You were %@py.round:@py.abs:-wait guess: accu:% second(s) off."