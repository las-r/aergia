%YAML 1.2
---
name: Aergia
file_extensions:
  - aer
scope: source.aergia

contexts:
  main:
    # Comments
    - match: '#.*$'
      scope: comment.line.number-sign.aergia

    # Strings
    - match: '"'
      scope: punctuation.definition.string.begin.aergia
      push: string-double

    # Support Functions (e.g., @print or @math.floor)
    - match: '(@)([a-zA-Z_][\w.]*)'
      scope: support.function.aergia
      captures:
        1: punctuation.definition.function.aergia
        2: support.function.name.aergia

    # Control Operators
    - match: '<<<|>>>|@!:|<!:|>!:|!!:|\+>|\+<|\*>|\*<|~>|->|=>'
      scope: keyword.operator.control.aergia

    # Comparison Operators
    - match: '==|!=|<=|>=|<<|>>|=\?'
      scope: keyword.operator.comparison.aergia

    # Array Manipulation Operators
    - match: '\+:|-:|~:|\*:|#:|::|\.\.'
      scope: keyword.operator.array.aergia

    # Logical Operators
    - match: '&&|\|\||!'
      scope: keyword.operator.logical.aergia

    # Miscellaneous Operators
    - match: '\$:|\^:|=:|=,|=\.|=\'''
      scope: keyword.operator.misc.aergia

    # Arithmetic & Simple Operators
    - match: '~|&|\||\$|\+|-|\*|/|%|\^|@|:|=|\?|;|<|>|,|\.|\'''
      scope: keyword.operator.arithmetic.aergia

    # Brackets, Braces, and Backticks
    - match: '[\[\]\(\)\{\}\`]'
      scope: punctuation.section.bracket.aergia

    # Numeric Constants (handles numbers like 10, 3.14, .5, and _100)
    - match: '\b_?\d+(\.\d+)?\b|\.\d+'
      scope: constant.numeric.aergia

    # Variables / Identifiers
    - match: '\b[a-zA-Z_][\w.]*\b'
      scope: variable.other.aergia

  # Handles string content and nested string interpolation %...%
  string-double:
    - meta_scope: string.quoted.double.aergia
    - match: '\\.'
      scope: constant.character.escape.aergia
    - match: '%'
      scope: punctuation.definition.interpolation.begin.aergia
      push: string-interpolation
    - match: '"'
      scope: punctuation.definition.string.end.aergia
      pop: true

  # Context for evaluating language structures inside string interpolation %...%
  string-interpolation:
    - meta_scope: meta.interpolation.aergia
    - match: '%'
      scope: punctuation.definition.interpolation.end.aergia
      pop: true
    - include: main
