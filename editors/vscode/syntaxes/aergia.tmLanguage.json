{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aergia",
  "scopeName": "source.aergia",
  "patterns": [
    {
      "name": "comment.line.number-sign.aergia",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.aergia",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aergia",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.aergia",
          "begin": "%",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.aergia" }
          },
          "end": "%",
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.aergia" }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    {
      "name": "support.function.aergia",
      "match": "(@)([a-zA-Z_][\\w.]*)",
      "captures": {
        "1": { "name": "punctuation.definition.function.aergia" },
        "2": { "name": "support.function.name.aergia" }
      }
    },
    {
      "name": "keyword.operator.control.aergia",
      "match": "(\\+>|\\*>|\\*<|~>|<<<|>>>)"
    },
    {
      "name": "keyword.operator.arithmetic.aergia",
      "match": "(~|&|\\||\\$|\\+|-|\\*|/|%|\\^)"
    },
    {
      "name": "keyword.operator.comparison.aergia",
      "match": "(==|!=|<=|>=|<<|>>)"
    },
    {
      "name": "keyword.operator.array.aergia",
      "match": "(\\+:|-:|~:|\\*:|#:|::)"
    },
    {
      "name": "keyword.operator.logical.aergia",
      "match": "(&&|\\|\\||!)"
    },
    {
      "name": "keyword.operator.misc.aergia",
      "match": "(@|:|=|;|\\?|<|>|,|\\.|')"
    },
    {
      "name": "punctuation.section.bracket.aergia",
      "match": "[\\[\\]\\(\\)\\{\\}\\`]"
    },
    {
      "name": "constant.numeric.aergia",
      "match": "\\b_?\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "variable.other.aergia",
      "match": "\\b[a-zA-Z_][\\w.]*\\b"
    }
  ]
}